{
  "name": "json-term",
  "version": "1.2.0",
  "description": "High-fidelity interactive terminal JSON viewer, collapsible tree explorer, type syntax highlighter, and structural diff tool.",
  "keywords": [
    "json",
    "terminal",
    "viewer",
    "diff",
    "json-diff",
    "tui",
    "interactive",
    "tree",
    "syntax-highlighting",
    "cli"
  ],
  "author": "authoritydmc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authoritydmc/json-term.git"
  },
  "bugs": {
    "url": "https://github.com/authoritydmc/json-term/issues"
  },
  "homepage": "https://github.com/authoritydmc/json-term#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "json-term": "./dist/cli.js",
    "jsonx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/test/json-term.test.ts",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build && npm test",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
